{
  "name": "maharaja-ride",
  "version": "0.0.1",
  "description": "First-person voxel bike ride through Bangalore peak traffic",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "node scripts/build.mjs",
    "release": "node scripts/build.mjs --release",
    "test:smoke": "python3 tests/smoke.py",
    "all": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.187.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
